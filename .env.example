# Light NC Sign settings. Copy to .env.prod and fill in. Never commit real values.

# --- Front end ---------------------------------------------------------------
# Same value as APP_ID below.
REACT_APP_APPID=lnc-sign
# Public address of the API, for example https://sign.example.org/api/app
REACT_APP_SERVERURL=

# --- Server ------------------------------------------------------------------
# Short app identifier. Must match REACT_APP_APPID.
APP_ID=lnc-sign
# Long random secret. Gives full access to all data; keep it private.
MASTER_KEY=
# MongoDB address, for example mongodb://mongo:27017/lncsign
MONGODB_URI=
# Do not change.
PARSE_MOUNT=/app
# Public API address, for example https://sign.example.org/api/app
SERVER_URL=
# Fixed: the server talks to itself on this port.
PORT=8080
# Must be true: documents are kept on local disk (no S3 / Spaces).
USE_LOCAL=true

# --- Email (set SMTP_ENABLE=true to use SMTP) ---------------------------------
SMTP_ENABLE=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_USER_EMAIL=
SMTP_PASS=

# --- Document signing certificate ---------------------------------------------
# Base64 of the .pfx file, and its passphrase.
PFX_BASE64=
PASS_PHRASE=

# Not used in Light NC Sign: SSO_API_URL, GOOGLE_CLIENT_ID, DO_* (storage), MAILGUN_* (optional).
