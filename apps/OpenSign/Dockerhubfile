# Light NC Sign front end (fork of OpenSign, AGPL-3.0). Built by .github/workflows/release.yml.
FROM node:22.23.0

WORKDIR /usr/src/app

# Install from the lock file so the build is repeatable
COPY apps/OpenSign/package*.json ./
RUN npm ci

COPY apps/OpenSign/ .
COPY apps/OpenSign/.husky .
COPY apps/OpenSign/entrypoint.sh .
RUN chmod +x entrypoint.sh

ENV NODE_ENV=production
ENV GENERATE_SOURCEMAP=false
# The release tag shown in the footer and linked to our source (set by the release workflow)
ARG LNC_SIGN_TAG=lnc-v2.41.3-1
ENV LNC_SIGN_TAG=$LNC_SIGN_TAG
RUN npm run build

# Fail the build if the page would call any outside host or still carries upstream branding
RUN sh ./audit-build.sh

# Inject env.js loader into index.html
RUN sed -i '/<head>/a\<script src="/env.js"></script>' build/index.html

EXPOSE 3000

ENTRYPOINT ["./entrypoint.sh"]
CMD ["npm", "start"]
